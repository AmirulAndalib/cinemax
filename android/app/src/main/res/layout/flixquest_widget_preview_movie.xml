<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:layout_margin="5dp"
    android:background="@drawable/flixquest_widget_background"
    android:padding="14dp">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center_vertical"
        android:orientation="vertical">
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="@font/figtree_family"
            android:text="MOVIE OF THE DAY"
            android:textColor="#FFF57C00"
            android:textSize="10sp"
            android:textStyle="bold" />
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:fontFamily="@font/figtree_family"
            android:maxLines="2"
            android:text="Your daily movie pick"
            android:textColor="#FFFFFFFF"
            android:textSize="21sp"
            android:textStyle="bold" />
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:fontFamily="@font/figtree_family"
            android:text="Picked for today"
            android:textColor="#CCFFFFFF"
            android:textSize="12sp" />
    </LinearLayout>
</FrameLayout>
